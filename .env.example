# Copy to .env for reference, but never commit a real .env file.
AGENTIC_RAG_PROVIDER=openai-compatible
OPENAI_API_KEY=replace-with-your-own-key
# Optional endpoint override for OpenAI-compatible services:
# OPENAI_BASE_URL=https://api.openai.com/v1

# For local Ollama, use AGENTIC_RAG_PROVIDER=ollama and optionally set:
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_API_KEY=ollama
